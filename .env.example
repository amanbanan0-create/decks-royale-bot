# Telegram bot token from BotFather. Never commit a real token.
BOT_TOKEN=123456:replace-with-real-bot-token

# Optional comma-separated Telegram user IDs allowed to use admin-only bot actions.
ADMIN_IDS=123456789

# Random secret used by Telegram webhook verification. Use at least 16 characters in production.
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Optional separate secret for /api-status, /api-test and /webhook-status.
# If omitted, the hardened runtime falls back to WEBHOOK_SECRET.
DIAGNOSTICS_SECRET=replace-with-a-separate-long-random-secret

# Clash Royale API token used for live production data.
CLASH_ROYALE_API_KEY=replace-with-clash-royale-api-key

# Public HTTPS URL of the Python bot service on Render.
RENDER_EXTERNAL_URL=https://your-bot-service.onrender.com

# Public HTTPS URL of the Telegram Mini App.
MINI_APP_URL=https://your-mini-app.example.com

# PostgreSQL connection string. Required by the hardened production wrapper.
DATABASE_URL=postgresql://user:password@host:5432/database
